# ============================================
# AI Service Environment Configuration
# ============================================
# Copy this file to .env and adjust as needed

AI_HOST=0.0.0.0
AI_PORT=8000
AI_ENVIRONMENT=development
AI_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173
AI_LOG_LEVEL=INFO

# Model Configuration
AI_FACE_DETECTION_CONFIDENCE=0.5
AI_ENGAGEMENT_SAMPLE_INTERVAL=5

# NLP Moderation
AI_MODERATION_MODEL=unitary/toxic-bert
AI_MODERATION_THRESHOLD=0.7
