# ============================================
# Backend Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/virtual-classroom

# JWT Authentication
JWT_SECRET=your-jwt-secret-must-be-at-least-32-characters-long-change-this
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-must-be-at-least-32-characters-long-change-this
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# AI Service URL
AI_SERVICE_URL=http://localhost:8000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging (morgan format: dev, combined, common, short, tiny)
LOG_LEVEL=dev
